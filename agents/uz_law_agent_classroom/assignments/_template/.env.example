# Only for LIVE runs (python -m uz_agent.agent "question"). Replaying a recorded run and the self-checks need no
# key and no network. Copy this file to .env and fill it in; .env is never submitted and never committed.
LLM_API_KEY=
# The model name and the API address of any OpenAI-compatible service. Leave empty for the defaults in
# uz_agent/config.py.
LLM_MODEL=
LLM_BASE_URL=
